# Telegram Bot Token (Telegram @BotFather orqali olinadi)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Database URL (Standart: SQLite)
DATABASE_URL=sqlite+aiosqlite:///bot.db

# Parollarni AES-256 bilan shifrlash kaliti (bo'sh qolsa bot o'zi yaratadi)
ENCRYPTION_KEY=

# Xabarlarni avtomatik o'chirish vaqti (daqiqada)
AUTO_DELETE_MINUTES=20

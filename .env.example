# ==============================================================================
# Telegram Bot Sozlamalari
# ==============================================================================
# Telegram @BotFather dan olingan bot tokeni
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# ==============================================================================
# Ma'lumotlar Bazasi (PostgreSQL)
# ==============================================================================
# Docker Compose da ishlatganda:
DATABASE_URL=postgresql+asyncpg://botuser:ChangeThisSecureDbPassword2026!@db:5432/botdb
# AWS RDS yoki tashqi serverda ishlatganda misol:
# DATABASE_URL=postgresql+asyncpg://postgres:parol@your-rds-endpoint.amazonaws.com:5432/botdb
# Lokal SQLite da sinash uchun:
# DATABASE_URL=sqlite+aiosqlite:///bot.db

# Docker-compose da PostgreSQL konteyneri uchun parametrlar:
POSTGRES_DB=botdb
POSTGRES_USER=botuser
POSTGRES_PASSWORD=ChangeThisSecureDbPassword2026!

# ==============================================================================
# Xavfsizlik va Shifrlash (Juda Muhim!)
# ==============================================================================
# Parollarni AES-256 bilan shifrlash kaliti (Fernet 44-belgili base64 kalit).
# DIQQAT: Agar bazada eski parollar bo'lsa, ularni deshifrlash uchun
# lokal kompyuteringizdagi .secret_key ichidagi kalitni shu yerga yozing!
ENCRYPTION_KEY=

# Ishlash muhiti (production / development)
ENVIRONMENT=production

# Xabarlarni avtomatik o'chirish vaqti (daqiqada)
AUTO_DELETE_MINUTES=20

# Anti-flood va Brute-Force himoya sozlamalari
RATE_LIMIT_DELAY=0.5
MAX_PIN_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=10

# (Ixtiyoriy) AWS S3 ga avtomatik zaxira nusxalash (backup) uchun bucket nomi:
AWS_S3_BACKUP_BUCKET=

